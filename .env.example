# --- Google Maps provider -------------------------------------------------
# playwright  - free, no API key (fragile, slower, may hit consent/captcha)
# apify       - paid Apify actor, most reliable
# outscraper  - paid Outscraper API
MAPS_PROVIDER=playwright

# Apify (https://console.apify.com/account/integrations)
APIFY_TOKEN=
APIFY_ACTOR=compass/crawler-google-places
# Google search through Apify is used for Facebook/e-mail lookup (~$0.001/result)
APIFY_SEARCH_ACTOR=apify/google-search-scraper

# Outscraper (https://app.outscraper.com/profile)
OUTSCRAPER_API_KEY=

# SerpAPI (https://serpapi.com/manage-api-key) - OPTIONAL.
SERPAPI_KEY=

# --- E-mail search fallback ----------------------------------------------
# auto | apify | serpapi | ddg
# auto = SerpAPI (if key) -> Apify Google search (if token) -> DuckDuckGo
SEARCH_BACKEND=auto
# pause between search queries, seconds (DuckDuckGo throttles aggressively)
SEARCH_DELAY=4
# how long a rate-limited backend stays paused, seconds
SEARCH_COOLDOWN=120
# safety cap for the automatic "2 queries per venue" search budget
SEARCH_MAX_QUERIES=400
# max seconds to wait for one Apify search run
SEARCH_TIMEOUT=420

# --- Networking -----------------------------------------------------------
HTTP_TIMEOUT=15
HTTP_WORKERS=8

# --- Browsers -------------------------------------------------------------
# 1 = headless, 0 = show the browser window (useful for debugging Maps/captcha)
HEADLESS=1

# --- Outgoing mail: python main.py send -----------------------------------
# Works with Gmail/Yandex/Mail.ru/Outlook or any SMTP provider.
# STARTTLS example (port 587): SMTP_SSL=0, SMTP_STARTTLS=1
# Implicit TLS example (port 465): SMTP_SSL=1, SMTP_STARTTLS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=0
SMTP_STARTTLS=1
# Visible sender. Defaults to SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Alex Los
# Optional Reply-To and BCC (e.g. your own address for a copy).
MAIL_REPLY_TO=
MAIL_BCC=
# Pause between letters (seconds) and a hard daily cap.
MAIL_DELAY=30
MAIL_DAILY_LIMIT=50
