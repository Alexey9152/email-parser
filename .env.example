# --- Venue provider -------------------------------------------------------
# osm         - FREE OpenStreetMap/Overpass, no key (recommended)
# playwright  - FREE Google Maps scraping (may hit consent/captcha)
# apify       - PAID Apify actor
# outscraper  - PAID Outscraper API
MAPS_PROVIDER=osm

# Apify (https://console.apify.com/account/integrations) - only used when
# MAPS_PROVIDER=apify or SEARCH_BACKEND=apify.
APIFY_TOKEN=
APIFY_ACTOR=compass/crawler-google-places
# Google search through Apify is PAID; it is never used by SEARCH_BACKEND=auto.
APIFY_SEARCH_ACTOR=apify/google-search-scraper

# Outscraper (https://app.outscraper.com/profile)
OUTSCRAPER_API_KEY=

# SerpAPI (https://serpapi.com/manage-api-key) - PAID, opt-in only.
SERPAPI_KEY=

# --- E-mail search fallback ----------------------------------------------
# auto | ddgs | ddg | apify | serpapi | none
# auto = FREE DDGS (DuckDuckGo/Brave/Yahoo/...) -> DuckDuckGo HTML.
# Paid backends are used only when selected by name.
SEARCH_BACKEND=auto
# pause between search queries, seconds (free engines throttle aggressively)
SEARCH_DELAY=4
# how long a rate-limited backend stays paused, seconds
SEARCH_COOLDOWN=120
# safety cap for the automatic "1 query per venue" search budget
SEARCH_MAX_QUERIES=250
# max seconds to wait for one Apify search run (paid backends only)
SEARCH_TIMEOUT=420

# --- Networking -----------------------------------------------------------
HTTP_TIMEOUT=15
HTTP_WORKERS=8

# --- Browsers -------------------------------------------------------------
# 1 = headless, 0 = show the browser window (useful for debugging Maps/captcha)
HEADLESS=1
# Optional Facebook session for pages that require login or show an 18+ gate.
# Create it once with: python main.py facebook-login
# Leave empty to auto-detect data/facebook-profile.
FACEBOOK_PROFILE_DIR=
# Alternative to the profile: a Playwright storage-state JSON with cookies.
FACEBOOK_STORAGE_STATE=

# --- Outgoing mail: python main.py send -----------------------------------
# Works with Gmail/Yandex/Mail.ru/Outlook or any SMTP provider.
# STARTTLS example (port 587): SMTP_SSL=0, SMTP_STARTTLS=1
# Implicit TLS example (port 465): SMTP_SSL=1, SMTP_STARTTLS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=0
SMTP_STARTTLS=1
# Visible sender. Defaults to SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Alex Los
# Optional Reply-To and BCC (e.g. your own address for a copy).
MAIL_REPLY_TO=
MAIL_BCC=
# Pause between letters (seconds) and a hard daily cap.
MAIL_DELAY=30
MAIL_DAILY_LIMIT=50
