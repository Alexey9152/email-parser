# --- Google Maps provider -------------------------------------------------
# playwright  - free, no API key (fragile, slower, may hit consent/captcha)
# apify       - paid Apify actor, most reliable
# outscraper  - paid Outscraper API
MAPS_PROVIDER=playwright

# Apify (https://console.apify.com/account/integrations)
APIFY_TOKEN=
APIFY_ACTOR=compass/crawler-google-places

# Outscraper (https://app.outscraper.com/profile)
OUTSCRAPER_API_KEY=

# SerpAPI (https://serpapi.com/manage-api-key) - OPTIONAL.
# Leave empty to use the key-free DuckDuckGo -> Bing fallback.
SERPAPI_KEY=

# --- E-mail search fallback ----------------------------------------------
# auto | duckduckgo | serpapi
SEARCH_BACKEND=auto
# pause between search queries, seconds (DuckDuckGo throttles aggressively)
SEARCH_DELAY=4
# how long a rate-limited backend stays paused, seconds
SEARCH_COOLDOWN=120

# --- Networking -----------------------------------------------------------
HTTP_TIMEOUT=15
HTTP_WORKERS=8

# --- Browsers -------------------------------------------------------------
# 1 = headless, 0 = show the browser window (useful for debugging Maps/captcha)
HEADLESS=1
